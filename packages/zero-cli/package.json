{
  "name": "@zeroopensource/zero-cli",
  "version": "0.0.4",
  "description": "Unified CLI entry point for all Zero open source packages",
  "author": "Jigz <jigzpalillo@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/zeroopensource/zero-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroopensource/zero-cli.git"
  },
  "bugs": {
    "url": "https://github.com/zeroopensource/zero-cli/issues"
  },
  "type": "module",
  "types": "./dist/zero-cli.d.ts",
  "bin": {
    "zero": "./dist/zero-cli.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "cpx ../../README.md ./",
    "lint": "cross-env TIMING=1 eslint \"**/*.ts*\"",
    "build": "tsdown",
    "zero": "zero"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "resolve": "1.22.10",
    "@zeroopensource/zero-official": "latest",
    "@zeroopensource/zero-id": "latest"
  },
  "devDependencies": {
    "@types/resolve": "1.20.6"
  },
  "exports": {
    "./commander-parse-int": {
      "import": "./dist/commander-parse-int.mjs",
      "require": "./dist/commander-parse-int.cjs"
    },
    "./zero-cli": {
      "import": "./dist/zero-cli.mjs",
      "require": "./dist/zero-cli.cjs"
    },
    "./package.json": "./package.json"
  }
}
