{
  "name": "@zeroopensource/zero-cli",
  "version": "0.0.6",
  "description": "Unified CLI entry point for all Zero open source packages",
  "author": "Jigz <jigzpalillo@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/zeroopensource/zero-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroopensource/zero-cli.git"
  },
  "bugs": {
    "url": "https://github.com/zeroopensource/zero-cli/issues"
  },
  "type": "module",
  "types": "./dist/zero-cli.d.ts",
  "bin": {
    "zero": "./dist/zero-cli.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md', 'README.md')\"",
    "lint": "cross-env TIMING=1 eslint \"**/*.ts*\"",
    "build": "tsdown",
    "zero-cli": "node ./dist/zero-cli.cjs"
  },
  "dependencies": {
    "@zeroopensource/zero-id": "latest",
    "@zeroopensource/zero-official": "latest",
    "commander": "^14.0.0",
    "fs-extra": "^11.4.0",
    "resolve": "1.22.10",
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/resolve": "1.20.6"
  },
  "exports": {
    "./build-index": {
      "import": "./dist/build-index.mjs",
      "require": "./dist/build-index.cjs"
    },
    "./commander-parse-int": {
      "import": "./dist/commander-parse-int.mjs",
      "require": "./dist/commander-parse-int.cjs"
    },
    "./get-markdown-paths": {
      "import": "./dist/get-markdown-paths.mjs",
      "require": "./dist/get-markdown-paths.cjs"
    },
    "./parse-markdown": {
      "import": "./dist/parse-markdown.mjs",
      "require": "./dist/parse-markdown.cjs"
    },
    "./zero-cli": {
      "import": "./dist/zero-cli.mjs",
      "require": "./dist/zero-cli.cjs"
    },
    "./package.json": "./package.json"
  }
}
